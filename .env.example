# ApnaPick Environment Example
# Copy to `.env.local` — never commit secrets.

# -----------------------------------------------------------------------------
# Public (safe for the browser — NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ApnaPick
NEXT_PUBLIC_DEFAULT_CITY=Pune
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_LAT=18.551
NEXT_PUBLIC_DEFAULT_LNG=73.94

# Local: `supabase start`, then copy API URL + keys from `supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Client analytics switch (still uses abstraction; default off in Phase 1)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Server-only (never expose to the browser)
# -----------------------------------------------------------------------------
# Lets privileged server jobs (webhooks, team email lookup, admin Auth APIs) talk to Supabase.
SUPABASE_SERVICE_ROLE_KEY=
SEARCH_DEFAULT_RADIUS_M=8000
LOG_LEVEL=info

# Razorpay billing (webhooks are source of truth for subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_BUSINESS=

# Redis URL for multi-instance rate limiting (Vercel: Upstash rediss:// or https://)
# RATE_LIMIT_REDIS_URL=

# Optional error reporting (server-only). Leave empty to no-op.
# SENTRY_DSN=

# Override feature flags as JSON, e.g. {"searchEnabled":true,"paidPlacementEnabled":false}
# FEATURE_FLAGS_JSON=
