# ApnaPick Environment Example
# Copy to `.env.local` — never commit secrets.

# -----------------------------------------------------------------------------
# Public (safe for the browser — NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ApnaPick
NEXT_PUBLIC_DEFAULT_CITY=Pune
NEXT_PUBLIC_DEFAULT_COUNTRY=IN
NEXT_PUBLIC_DEFAULT_LAT=18.5204
NEXT_PUBLIC_DEFAULT_LNG=73.8567

# Local: `supabase start`, then copy API URL + keys from `supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Client analytics switch (still uses abstraction; default off in Phase 1)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Stripe publishable key (Checkout.js / Elements if used later)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Server-only (never expose to the browser)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
SEARCH_DEFAULT_RADIUS_M=8000
LOG_LEVEL=info

# Stripe billing (webhooks are source of truth for subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=

# Optional Redis URL for multi-instance rate limiting
# RATE_LIMIT_REDIS_URL=

# Override feature flags as JSON, e.g. {"searchEnabled":true,"paidPlacementEnabled":false}
# FEATURE_FLAGS_JSON=
